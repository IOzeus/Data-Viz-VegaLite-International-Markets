{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "title": {
    "text": "GDP ($B)",
    "subtitle": "Country size = economic output",
    "font": "Inter",
    "fontSize": 16,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "color": "#1B2838"
  },
  "projection": {
    "type": "equalEarth"
  },
  "data": {
    "url": "data/cartogram-gdp-data.json",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#fff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "shape": {
      "field": "geometry",
      "type": "geojson"
    },
    "color": {
      "field": "properties.GDP_B",
      "type": "quantitative",
      "scale": {
        "scheme": "blues",
        "domain": [
          0,
          5000
        ]
      },
      "legend": {
        "title": "GDP ($B)",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "properties.NAME",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "properties.GDP_B",
        "type": "quantitative",
        "title": "GDP ($B)",
        "format": ",.0f"
      },
      {
        "field": "properties.MarketCap_Billion_USD",
        "type": "quantitative",
        "title": "Market Cap ($B)",
        "format": ",.0f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "background": "#ffffff",
    "font": "Inter"
  }
}