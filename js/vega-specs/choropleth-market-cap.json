{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": null,
  "width": "container",
  "height": 400,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {"url": "data/market-cap-by-country.csv"},
            "key": "Code_Numeric",
            "fields": ["Country", "MarketCap_GDP_Pct", "MarketCap_Billion_USD", "Year"]
          }
        },
        {"filter": "datum.Year == 2024"}
      ],
      "mark": {"type": "geoshape", "stroke": "#e2ddd0", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "field": "MarketCap_GDP_Pct",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domain": [0, 200]
          },
          "legend": {
            "title": "Market Cap (% of GDP)",
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "MarketCap_GDP_Pct", "type": "quantitative", "title": "% of GDP", "format": ".1f"},
          {"field": "MarketCap_Billion_USD", "type": "quantitative", "title": "Market Cap ($B)", "format": ",.1f"}
        ]
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/vega-datasets@2/data/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "id",
          "from": {
            "data": {"url": "data/market-cap-by-country.csv"},
            "key": "Code_Numeric",
            "fields": ["Country"]
          }
        },
        {"filter": "datum.Country == null"}
      ],
      "mark": {"type": "geoshape", "fill": "#e8e8e8", "stroke": "#e2ddd0", "strokeWidth": 0.5}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "background": "#ffffff",
    "font": "Verdana",
    "title": {"font": "Georgia", "fontSize": 16, "color": "#0d3b2e"}
  }
}
